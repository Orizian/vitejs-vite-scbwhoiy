    "allowElimination": true,
    "phases": []
  },
  "phases": [],
  "scenes": {
    "briefing": {
      "title": "Real Alarm",
      "location": "Bellview Pump Station",
      "kind": "briefing",
      "lines": [
        {
          "speaker": "government",
          "text": "Bellview's pump station is under coordinated raider assault. Water for four districts runs through it."
        },
        {
          "speaker": "commander",
          "text": "This one is real. Personnel first, then the pumps."
        },
        {
          "speaker": "reyes",
          "text": "Finally, an order that makes sense."
        },
        {
          "speaker": "kell",
          "text": "Let us see whether the attackers do."
        }
      ],
      "choices": []
    },
    "aftermath": {
      "title": "A Useful Victory",
      "location": "Bellview Pump Station",
      "kind": "propaganda",
      "lines": [
        {
          "speaker": "commander",
          "text": "Station holds. Get the crew inside and the west housing sealed."
        },
        {
          "speaker": "broadcast",
          "text": "A massive offensive was shattered today by the vigilance of the Chancellor's defence network."
        },
        {
          "speaker": "kell",
          "text": "Eleven attackers. No reserve, no extraction plan, matching serial mounts."
        },
        {
          "speaker": "reyes",
          "text": "Real people needed us. That does not make the report honest."
        }
      ],
      "choices": []
    },
    "defeat": {
      "title": "Station Lost",
      "location": "Bellview Pump Station",
      "kind": "dialogue",
      "lines": [
        {
          "speaker": "reyes",
          "text": "We are losing the yard. Pull back before the crew is trapped in there."
        }
      ],
      "choices": []
    }
  },
  "sequences": {
    "briefing": [
      "briefing"
    ],

      "title": "The Turn",
      "location": "Grayfield",
      "kind": "dialogue",
      "lines": [
        {
          "speaker": "commander",
          "text": "Kell is anchoring. He has the shot on me and he is not taking it."
        },
        {
          "speaker": "kell",
          "text": "You were supposed to move."
        },
        {
          "speaker": "kell",
          "text": "Not you, Commander. Them."

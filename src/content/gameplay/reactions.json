        "perActivation": 2,
        "perChain": 1
      },
      "effect": {
        "hasten": 120,
        "target": "self",
        "type": "modifyTurnDelay"
      }
    },
    "predatorTempoKill": {
      "name": "Predator's Tempo",
      "description": "A frame that finishes something in close quarters is already moving before the wreck lands. Its next activation comes sooner.",
      "trigger": "unitDestroyed",
      "priority": 40,
      "requires": {
        "status": "cloaked"
      },
      "conditions": [
        {
          "sourceIsReactor": true

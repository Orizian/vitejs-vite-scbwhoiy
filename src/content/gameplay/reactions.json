    "duelHoldTheLine": {
      "name": "Hold the Line",
      "description": "Nobody walks past her. The move is declared, and then it does not happen — and they have still spent it.",
      "trigger": "actionDeclared",
      "priority": 80,
      "requires": {
        "status": "onGuard"
      },
      "conditions": [
        {
          "reactorHasStatus": "onGuard"
        },
        {
          "declaredActionKind": "movement"
        },
        {
          "subjectRelation": "hostile"
        },
        {
          "triggeringActorStillValid": true
        },
        {
          "knowsSubject": "acquired"
        },
        {
          "withinRange": 1
        }
      ],
      "cost": {
        "resources": [
          {
            "amount": 1,
            "id": "poise"
          },
          {
            "amount": 1,
            "id": "commandPoints"
          }
        ]
      },
      "limits": {
        "perActivation": 1,
        "perChain": 1
      },
      "effect": {
        "type": "cancelTriggeringAction"
      }
    },

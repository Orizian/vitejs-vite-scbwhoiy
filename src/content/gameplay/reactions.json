{
  "format": "statuszero.gameplay",
  "formatVersion": 1,
  "registry": "reactions",
  "description": "Out-of-turn responses, as WHEN / IF / THEN. `trigger` is a generic event, `conditions` a declarative vocabulary, `effect` a registered primitive. No reaction names an engine behaviour that does not already exist.",
  "entries": {
    "heldFiringLane": {
      "name": "Held Firing Lane",
      "description": "A frame holding overwatch fires the moment a hostile it can see steps into the lane — or is put there by someone else.",
      "trigger": "unitMoved",
      "priority": 80,
      "requires": {
        "status": "overwatching"
      },
      "conditions": [
        {
          "reactorHasStatus": "overwatching"
        },
        {
          "subjectRelation": "hostile"
        },
        {
          "subjectAlive": true
        },
        {
          "knowsSubject": "acquired"
        },
        {
          "subjectBecameExposed": true
        },
        {
          "withinRange": 12
        }
      ],
      "cost": {
        "resources": [
          {
            "amount": 1,
            "id": "commandPoints"
          },
          {
            "amount": 1,
            "id": "reactionCapacity"
          }
        ]
      },
      "limits": {
        "perActivation": 1,
        "perChain": 1
      },
      "effect": {
        "formula": "physical",
        "power": 90,
        "targetFrom": "subject",
        "type": "reactionAttack"
      }
    },
    "predatorTempoEvade": {
      "name": "Slipstream",
      "description": "Reading a shot early is the same as starting to move early. Evading a hostile attack pulls this frame's next activation forward.",
      "trigger": "attackEvaded",
      "priority": 40,
      "requires": {
        "status": "cloaked"
      },
      "conditions": [
        {
          "subjectIsReactor": true
        },
        {
          "sourceRelation": "hostile"
        }
